# Backend Settings
TERRAEYES_ENV=development
TERRAEYES_HOST=0.0.0.0
TERRAEYES_PORT=8000
TERRAEYES_LOG_LEVEL=INFO
TERRAEYES_DB_PATH=./data/terraeyes.db
TERRAEYES_FAISS_INDEX_PATH=./data/faiss.index
TERRAEYES_TEMPORAL_STORE_PATH=./data/temporal_states.h5
TERRAEYES_MODELS_DIR=./models
TERRAEYES_DATA_DIR=./data
TERRAEYES_OSCD_DIR=./images

# Model Selection Configuration
TERRAEYES_EMBEDDING_MODEL=clip_vit_b32  # Options: mock | clip_vit_b32 | remote_clip
TERRAEYES_CHANGE_DETECTOR=pixel_diff    # Options: pixel_diff | bit_cd | mamba_cd
TERRAEYES_MAMBA_CHECKPOINT_PATH=./models/change_detection_candidates/mamba_oscd_best.pt
TERRAEYES_TILE_SIZE=256
TERRAEYES_EMBEDDING_DIM=512
TERRAEYES_CLIP_CHECKPOINT_PATH=./models/clip_vit_b32.pt
TERRAEYES_REMOTECLIP_CHECKPOINT_PATH=./models/remoteclip_vit_b32.pt

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000
